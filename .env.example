# -------- Device identity --------
EDGE_DEVICE_ID=WSL-POC-001

# -------- Local storage --------
TELEMETRY_DB_PATH=./data/telemetry.db
AUTH_DB_PATH=./data/auth_cache.db
SYNC_STATE_DB_PATH=./data/sync_state.db

# -------- Azure IoT Hub --------
# Device-scoped connection string only. Never place an iothubowner/service connection string here.
IOTHUB_DEVICE_CONNECTION_STRING=HostName=<hub>.azure-devices.net;DeviceId=WSL-POC-001;SharedAccessKey=<device-key>
TELEMETRY_POLL_SECONDS=5
TELEMETRY_BATCH_SIZE=100
TELEMETRY_RETRY_MAX_SECONDS=300

# -------- RBAC snapshot API --------
RBAC_API_BASE_URL=https://<function-app>.azurewebsites.net/api
RBAC_API_KEY=<function-host-key>
RBAC_SYNC_SECONDS=300
RBAC_HTTP_TIMEOUT_SECONDS=20

# -------- Microsoft Entra interactive login (for online enrollment / verification) --------
ENTRA_TENANT_ID=<tenant-guid>
EDGE_PUBLIC_CLIENT_ID=<EdgeDeviceApplication-client-id>

# -------- Offline authentication policy --------
OFFLINE_AUTH_MAX_FAILED=5
OFFLINE_AUTH_LOCK_SECONDS=300

# Logging
LOG_LEVEL=INFO
